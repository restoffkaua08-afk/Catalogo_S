# E-mails com acesso. Separe por vírgula ou quebra de linha.
AUTHORIZED_EMAILS=voce@exemplo.com,cliente@exemplo.com

# Gere uma chave longa e aleatória. Nunca coloque a chave real no GitHub.
AUTH_SECRET=troque-por-uma-chave-longa-e-aleatoria

# Provider de e-mail: auto, mailjet ou resend.
# auto prioriza Mailjet e usa Resend como fallback se ambos estiverem configurados.
EMAIL_PROVIDER=auto

# Remetente validado no provider de e-mail.
AUTH_FROM_EMAIL=Catálogo S <acesso@seudominio.com>
AUTH_FROM_NAME=Catálogo S

# Mailjet (opção principal gratuita)
MAILJET_API_KEY=xxxxxxxxxxxxxxxx
MAILJET_SECRET_KEY=xxxxxxxxxxxxxxxx

# Resend (fallback opcional)
RESEND_API_KEY=re_xxxxxxxxx

# Opcionais
OTP_TTL_SECONDS=300
OTP_COOLDOWN_SECONDS=45
OTP_MAX_ATTEMPTS=5
SESSION_TTL_HOURS=12
